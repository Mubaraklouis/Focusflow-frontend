{
  "entryPoints": [
    "server/api",
    "server/controller",
    "server/types",
    "server/util"
  ],
  "entryPointStrategy": "expand",
  "out": "docs/api",
  "tsconfig": "./tsconfig.typedoc.json",
  "plugin": [
    "typedoc-material-theme"
  ],
  "exclude": [
    "**/*.spec.ts",
    "node_modules/**"
  ],
  "name": "FocusFlow Server Documentation",
  "includeVersion": true,
  "searchInComments": true,
  "cleanOutputDir": true
}