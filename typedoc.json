{
  "entryPoints": [
    "app/composables",
    "app/middleware",
    "server/api",
    "server/composables",
    "server/util"
  ],
  "entryPointStrategy": "expand",
  "out": "docs/api",
  "plugin": [
    "typedoc-material-theme"
  ],
  "exclude": [
    "**/*.spec.ts",
    "**/*.vue",
    "node_modules/**"
  ],
  "name": "FocusFlow Documentation",
  "includeVersion": true,
  "searchInComments": true,
  "cleanOutputDir": true,
  "skipErrorChecking": true,
  "tsconfig": "tsconfig.typedoc.json"
}