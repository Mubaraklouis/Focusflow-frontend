# ===========================================================
# Environment variables for the FocusFlow frontend.
#
# You do NOT need to set these on Vercel — nuxt.config.ts already
# defaults to the production backends. Set them only to override
# (e.g. local dev, or pointing Vercel at different backends).
#
# Precedence: NUXT_* env var  >  nuxt.config.ts default
# ===========================================================

# ---- LOCAL DEVELOPMENT (copy to .env) ----
NUXT_USERS_API_URL=http://localhost:8000
NUXT_COURSES_API_URL=http://localhost:8081/api/course
NUXT_COURSE_MATERIAL_API_URL=http://localhost:8080/api/courses
NUXT_FRONTEND_URL=http://localhost:3000
NUXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ---- PRODUCTION (already the nuxt.config.ts defaults) ----
# NUXT_USERS_API_URL=http://56.228.5.72
# NUXT_COURSES_API_URL=http://13.61.153.194/api/course
# NUXT_COURSE_MATERIAL_API_URL=http://13.48.190.13/api/courses
# NUXT_FRONTEND_URL=https://focusfllow.vercel.app
# NUXT_PUBLIC_BACKEND_URL=http://56.228.5.72

# ---- Optional ----
# NUXT_LARAVEL_API_URL=
# NUXT_PUBLIC_STRIPE_KEY=
