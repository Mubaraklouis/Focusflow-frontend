# Environment variables for the FocusFlow frontend.
# Production defaults live in nuxt.config.ts; set these only to override.

# FocusFlow API (server-side only; the browser goes through server/api/*)
# Local development against a local API:
NUXT_API_URL=http://localhost:8091
# Production (default in nuxt.config.ts):
# NUXT_API_URL=https://api.focusflow.sswoco.org

# ---- Optional ----
# NUXT_PUBLIC_STRIPE_KEY=
